{
  "name": "crescer-pediatria-integrada",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Crescer Pediatria Integrada — clínica de especialidades pediátricas em Macapá/AP",
  "scripts": {
    "dev": "vite --port 5176",
    "build": "tsc --noEmit && vite build && vite build --ssr src/entry-server.tsx --outDir dist-server && node scripts/prerender.mjs",
    "preview": "vite preview --port 5176",
    "build:gh": "cross-env VITE_BASE=/crescer-pediatria-integrada/ npm run build",
    "deploy:gh": "npm run build:gh && gh-pages -d dist --nojekyll -m \"Deploy\""
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.1.1",
    "@fontsource-variable/plus-jakarta-sans": "^5.1.1",
    "@phosphor-icons/react": "^2.1.10",
    "framer-motion": "^11.18.2",
    "lenis": "^1.1.20",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "cross-env": "^7.0.3",
    "gh-pages": "^6.3.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.6.3",
    "vite": "^5.4.11"
  }
}
