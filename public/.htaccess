# Crescer Pediatria Integrada: configuracao do Apache (HostGator)

DirectoryIndex index.html
Options -Indexes
ErrorDocument 404 /404.html
ErrorDocument 403 /404.html

# Forca HTTPS e remove o www (um unico redirecionamento 301)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]
</IfModule>

# Compressao
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>

# Cache: arquivos com hash (assets/) por 1 ano; imagens por 30 dias; HTML sempre revalidado
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
</IfModule>

<IfModule mod_headers.c>
  # HSTS: depois da primeira visita, o navegador abre sempre em HTTPS (some o "Nao seguro" ao digitar o endereco)
  Header always set Strict-Transport-Security "max-age=15552000"
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
